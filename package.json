{
	"name": "devsess-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for devsess: scaffold dev scripts with reusable dev sessions and a PGlite + Drizzle adapter.",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"scripts": {
		"build": "pnpm --filter devsess build",
		"docs": "pnpm --filter docs dev",
		"check": "turbo run check",
		"test": "turbo run test",
		"format": "biome check --write",
		"changeset": "changeset",
		"ci:version": "changeset version",
		"ci:release": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.27.0",
		"turbo": "^2.9.14"
	}
}
